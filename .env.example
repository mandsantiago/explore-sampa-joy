# Copie este arquivo para ".env" (mesmo nome, sem ".example") e preencha com
# os valores reais do seu projeto Supabase. O ".env" nunca é commitado
# (está no .gitignore) — essas chaves não devem ir para o GitHub.
#
# Onde encontrar: painel do Supabase → seu projeto → Settings → API

SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=coloque-aqui-a-chave-publica-anon
